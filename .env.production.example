# Configuration du serveur (VPS). Copier en .env.production sur le serveur, compléter, puis :
#   chmod 600 .env.production
# Ne jamais versionner .env.production (il est ignoré par Git et par Docker).
# Générer un secret :  openssl rand -hex 32

# --- Adresse ---
# Nom de domaine qui pointe vers l'IP du VPS (enregistrement DNS de type A)
DOMAIN=dashlife.exemple.fr
# Adresse e-mail pour Let's Encrypt (alertes d'expiration du certificat)
ACME_EMAIL=toi@exemple.fr

# --- Secrets ---
# Mot de passe de la base : uniquement des caractères hexadécimaux (openssl rand -hex 24)
POSTGRES_PASSWORD=
# Signature des sessions de connexion (openssl rand -hex 32)
NEXTAUTH_SECRET=
# Chiffrement des jetons OAuth en base : 64 caractères hexadécimaux.
# Pour reprendre tes données locales, copie EXACTEMENT la valeur de ton .env local,
# sinon les connexions (Gmail, GitHub…) seront à refaire.
ENCRYPTION_KEY=
# Appel des tâches planifiées (openssl rand -hex 32)
CRON_SECRET=

# --- Comptes ---
# false : personne ne peut créer de compte sur ton serveur (le tien est repris de la base locale)
ALLOW_REGISTRATION=false
# Pour inviter des amis (partage des voyages) : ALLOW_REGISTRATION=true et un code d'invitation.
# Seuls ceux à qui tu donnes ce code peuvent s'inscrire (openssl rand -hex 6). Change-le après coup.
# REGISTRATION_INVITE_CODE=

# --- IA ---
# Scan de plats et d'étiquettes : envoyé à l'API Claude (les photos de repas uniquement)
AI_PROVIDER=claude
# Clé API Anthropic (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Modèle Claude (défaut : claude-haiku-5-5, rapide et peu coûteux). Pour une lecture plus fine des
# photos difficiles : claude-sonnet-5-5 (~20x plus cher) ou claude-opus-5-5 (~40x plus cher).
# ANTHROPIC_MODEL=claude-haiku-5-5

# Mails (tri, candidatures, rendez-vous, factures jointes, demandes à l'agent) :
#   none   = aucune IA, le contenu des mails ne quitte jamais le serveur (règles locales) [défaut]
#   claude = envoi du contenu des mails à l'API Anthropic (meilleur tri, mais données hors du serveur)
#   ollama = IA de ton PC, joignable depuis le serveur (ex. via Tailscale) : renseigner OLLAMA_BASE_URL
AI_EMAIL_PROVIDER=none
# OLLAMA_BASE_URL=http://ton-pc.ton-reseau.ts.net:11434
# OLLAMA_MODEL=qwen3:latest

# --- Gmail (agent mail, abonnements) ---
# Ajouter https://DOMAIN/api/gmail/auth/callback aux URI de redirection autorisés du client OAuth Google.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optionnel : notifications Gmail en temps réel (Pub/Sub)
# GMAIL_PUBSUB_TOPIC=
# GMAIL_WEBHOOK_TOKEN=

# --- Intégrations optionnelles (redirection : https://DOMAIN/api/<service>/auth/callback) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# TRELLO_API_KEY=

# --- Notifications push (alertes des projets) ---
# npx web-push generate-vapid-keys  →  copier les deux clés ci-dessous (les garder : en changer
# désabonne tous les appareils)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:toi@exemple.fr   (défaut : ACME_EMAIL)
# Fuseau par défaut des alertes (remplacé par celui du navigateur dès la première visite)
# APP_TIMEZONE=Europe/Paris
